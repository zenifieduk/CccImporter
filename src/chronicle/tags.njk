---
layout: layouts/base.njk
pagination:
  data: collections.chronicleTagList
  size: 1
  alias: tag
  addAllPagesToCollections: false
  filter:
    - all
    - chronicle
  resolve: values
permalink: /chronicle/tags/{{ tag | slug }}/
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "Articles tagged with '{{ tag }}'"
  description: "All articles tagged with '{{ tag }}' in The Classic Chronicle on ClassicCarClubs.uk"
---

<link rel="stylesheet" href="/assets/css/chronicle.css">

<section class="hero-section secondary-hero-section" style="height: 30vh; min-height: 450px; background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/assets/images/blog-header.avif'); background-size: cover; background-position: center;">
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="breadcrumbs-container">
      <ul class="breadcrumbs">
        <li><a href="/" style="color: white;">Home</a></li>
        <li><a href="/chronicle/" style="color: white;">The Classic Chronicle</a></li>
        <li><a href="/chronicle/tags/{{ tag | slug }}/" style="color: white;">{{ tag }}</a></li>
      </ul>
    </div>

    <div class="hero-content">
      <h1 class="hero-title">Articles tagged with "{{ tag }}"</h1>
      <p class="hero-subtitle">Browse all articles related to {{ tag }}</p>
    </div>
  </div>
</section>

<section class="chronicle-list">
  <div class="container">
    <div class="chronicle-sidebar-layout">
      <div class="chronicle-main">
        <h2>Articles tagged with "{{ tag }}"</h2>
        
        <div class="chronicle-grid">
          {% set taglist = collections.chronicle | getTaggedItems(tag) %}
          {% for post in taglist %}
            <div class="chronicle-card">
              {% if post.data.featuredImage %}
                <div class="chronicle-card-image">
                  <img src="{{ post.data.featuredImage }}" alt="{{ post.data.title }}">
                </div>
              {% endif %}
              <div class="chronicle-card-content">
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                <div class="chronicle-card-meta">
                  <span class="chronicle-date">{{ post.date | chronicleDate }}</span>
                  <span class="chronicle-reading-time">{{ post.templateContent | readingTime }} min read</span>
                </div>
                <p>{{ post.data.excerpt or post.templateContent | excerpt }}</p>
                <a href="{{ post.url }}" class="read-more">Read More</a>
              </div>
            </div>
          {% endfor %}
        </div>

        <p class="back-link"><a href="/chronicle/">← Back to all articles</a></p>
      </div>

      <div class="chronicle-sidebar">
        <div class="sidebar-section">
          <h3>Categories</h3>
          <ul class="category-list">
            {% for tagName in collections.chronicleTagList %}
              <li><a href="/chronicle/tags/{{ tagName | slug }}/" {% if tagName === tag %}class="active"{% endif %}>{{ tagName }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="sidebar-section">
          <h3>Recent Articles</h3>
          <ul class="recent-posts">
            {% for post in collections.recentChronicle %}
              <li>
                <a href="{{ post.url }}">{{ post.data.title }}</a>
                <span class="post-date">{{ post.date | chronicleDate }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section> 