---
layout: layouts/base.njk
title: The Classic Chronicle
description: Latest news, stories, and insights about classic car clubs and events across the UK
permalink: /chronicle/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html
pagination:
  data: collections.chronicle
  size: 12
  alias: posts
eleventyExcludeFromCollections: true
---

<link rel="stylesheet" href="/assets/css/chronicle.css">

<section class="hero-section secondary-hero-section" style="height: 30vh; min-height: 450px; background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/assets/images/blog-header.avif'); background-size: cover; background-position: top;">
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="breadcrumbs-container">
      <ul class="breadcrumbs">
        <li><a href="/" style="color: white;">Home</a></li>
        <li><a href="/chronicle/" style="color: white;">The Classic Chronicle</a></li>
      </ul>
    </div>

    <div class="hero-content">
      <h1 class="hero-title">The Classic Chronicle</h1>
      <p class="hero-subtitle">News, stories, and insights about classic car clubs and events across the UK</p>
    </div>
  </div>
</section>

{% if collections.featuredChronicle.length > 0 and pagination.pageNumber === 0 %}
<section class="featured-posts">
  <div class="container">
    <h2>Featured Articles</h2>
    <div class="featured-grid">
      {% for post in collections.featuredChronicle %}
        <div class="featured-card">
          <div class="featured-badge">Featured</div>
          {% if post.data.featuredImage %}
            <div class="featured-card-image">
              <img src="{{ post.data.featuredImage }}" alt="{{ post.data.title }}">
            </div>
          {% endif %}
          <div class="featured-card-content">
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <div class="featured-card-meta">
              <span class="chronicle-date">{{ post.date | chronicleDate }}</span>
              <span class="chronicle-reading-time">{{ post.templateContent | readingTime }} min read</span>
            </div>
            <p>{{ post.data.excerpt or post.templateContent | excerpt }}</p>
            <a href="{{ post.url }}" class="read-more">Read More</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="chronicle-list">
  <div class="container">
    <div class="chronicle-sidebar-layout">
      <div class="chronicle-main">
        <div style="margin-bottom: 20px;">
          <p style="font-size: 0.8em; margin-bottom: 5px; text-align: left;">Sponsored Ad</p>
          <a rel="sponsored" href="https://www.awin1.com/cread.php?s=3848447&v=6293&q=510624&r=337591">
            <img src="/assets/images/ads/TYREFEST_offer_960x380-36.avif" alt="TYREFEST Offer" style="width: 100%; height: auto;">
          </a>
        </div>
        <h2>Latest Articles</h2>
        <div class="chronicle-grid">
          {% set featuredUrls = [] %}
          {% if collections.featuredChronicle.length > 0 and pagination.pageNumber === 0 %}
            {% for featuredPost in collections.featuredChronicle %}
              {% set featuredUrls = featuredUrls | concat([featuredPost.url]) %}
            {% endfor %}
          {% endif %}
          
          {% for post in posts %}
            {% if not (pagination.pageNumber === 0 and featuredUrls | includes(post.url)) %}
            <div class="chronicle-card">
              {% if post.data.featuredImage %}
                <div class="chronicle-card-image">
                  <img src="{{ post.data.featuredImage }}" alt="{{ post.data.title }}">
                </div>
              {% endif %}
              <div class="chronicle-card-content">
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                <div class="chronicle-card-meta">
                  <span class="chronicle-date">{{ post.date | chronicleDate }}</span>
                  <span class="chronicle-reading-time">{{ post.templateContent | readingTime }} min read</span>
                </div>
                <p>{{ post.data.excerpt or post.templateContent | excerpt }}</p>
                <a href="{{ post.url }}" class="read-more">Read More</a>
              </div>
            </div>
            {% endif %}
          {% endfor %}
        </div>

        <!-- Pagination -->
        {% if pagination.pages.length > 1 %}
          <nav class="pagination">
            <ul>
              {% if pagination.href.previous %}
                <li><a href="{{ pagination.href.previous }}">&laquo; Previous</a></li>
              {% else %}
                <li class="disabled"><span>&laquo; Previous</span></li>
              {% endif %}

              {% for pageEntry in pagination.pages %}
                <li{% if page.url == pagination.hrefs[ loop.index0 ] %} class="active"{% endif %}>
                  <a href="{{ pagination.hrefs[ loop.index0 ] }}">{{ loop.index }}</a>
                </li>
              {% endfor %}

              {% if pagination.href.next %}
                <li><a href="{{ pagination.href.next }}">Next &raquo;</a></li>
              {% else %}
                <li class="disabled"><span>Next &raquo;</span></li>
              {% endif %}
            </ul>
          </nav>
        {% endif %}
      </div>

      <div class="chronicle-sidebar">
        <div class="sidebar-section">
          <h3>Categories</h3>
          <ul class="category-list">
            {% for tag in collections.chronicleTagList %}
              <li><a href="/chronicle/tags/{{ tag | slug }}/">{{ tag }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="sidebar-section">
          <h3>Recent Articles</h3>
          <ul class="recent-posts">
            {% for post in collections.recentChronicle %}
              <li>
                <a href="{{ post.url }}">{{ post.data.title }}</a>
                <span class="post-date">{{ post.date | chronicleDate }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <iframe src="https://embeds.beehiiv.com/e6b43c29-16f4-4e4f-972d-540b14478731" data-test-id="beehiiv-embed" width="100%" height="320" frameborder="0" scrolling="no" style="border-radius: 4px; border: 2px solid #e5e7eb; margin: 0; background-color: transparent;"></iframe>
  </div>
</section> 