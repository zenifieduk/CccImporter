  }
  
  .event-list-item h4 {
    margin-top: 0;
    color: var(--button-colour);
  }
  
  /* Mobile Specific Styles */
</style>

<!-- Calendar Script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle between views
    const cardsViewBtn = document.getElementById('cardsViewBtn');
    const calendarViewBtn = document.getElementById('calendarViewBtn');
    const eventsCardsView = document.getElementById('eventsCardsView');
    const eventsCalendarView = document.getElementById('eventsCalendarView');
    const eventModal = document.getElementById('eventModal');
    const closeModal = document.querySelector('.close-modal');
    
    if (cardsViewBtn && calendarViewBtn) {
      cardsViewBtn.addEventListener('click', function() {
        eventsCardsView.style.display = 'block';
        eventsCalendarView.style.display = 'none';
        cardsViewBtn.classList.add('active-view');
        cardsViewBtn.classList.remove('button-secondary');
        cardsViewBtn.classList.add('button-primary');
        calendarViewBtn.classList.remove('active-view');
        calendarViewBtn.classList.remove('button-primary');
        calendarViewBtn.classList.add('button-secondary');
      });
      
      calendarViewBtn.addEventListener('click', function() {
        eventsCardsView.style.display = 'none';
        eventsCalendarView.style.display = 'block';
        calendarViewBtn.classList.add('active-view');
        calendarViewBtn.classList.remove('button-secondary');
        calendarViewBtn.classList.add('button-primary');
        cardsViewBtn.classList.remove('active-view');
        cardsViewBtn.classList.remove('button-primary');
        cardsViewBtn.classList.add('button-secondary');
      });
    }
    
    // Close modal when clicking X or outside modal
    if (closeModal) {
      closeModal.addEventListener('click', function() {
        eventModal.style.display = 'none';
      });
    }
    
    window.addEventListener('click', function(event) {
      if (event.target === eventModal) {
        eventModal.style.display = 'none';
      }
    });
    
    // Calendar functionality
    const calendar = document.getElementById('calendar');
    const calendarTitle = document.getElementById('calendarTitle');
    const prevMonthBtn = document.getElementById('prevMonth');
    const nextMonthBtn = document.getElementById('nextMonth');
    
    if (!calendar || !calendarTitle || !prevMonthBtn || !nextMonthBtn) return;
    
    let currentDate = new Date();
    let currentMonth = currentDate.getMonth();
    let currentYear = currentDate.getFullYear();
    
    // Format events for the calendar
    function formatEvents() {
      return eventsData.map(event => {
        let eventDate;
        try {
          // Parse the date from DDMMYYYY:HH:MM:SS format
          const day = event.eventStartDateTime.substring(0, 2);
          const month = event.eventStartDateTime.substring(2, 4);
          const year = event.eventStartDateTime.substring(4, 8);
          const time = event.eventStartDateTime.substring(9);
          eventDate = new Date(year + '-' + month + '-' + day + 'T' + time);
        } catch (error) {
          // If parsing fails, default to today
          eventDate = new Date();
        }
        
        return {
          ...event,
          parsedDate: eventDate
        };
      });
    }
    
    function renderCalendar() {
      // Clear previous calendar
      calendar.innerHTML = '';
      
      // Update header
      const monthNames = ["January", "February", "March", "April", "May", "June", 
                         "July", "August", "September", "October", "November", "December"];
      calendarTitle.textContent = `${monthNames[currentMonth]} ${currentYear}`;
      
      // Add day headers
      const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      dayNames.forEach(day => {
        const dayHeader = document.createElement('div');
        dayHeader.className = 'calendar-day-header';
        dayHeader.textContent = day;
        calendar.appendChild(dayHeader);
      });
      
      // Get first day of month and last day of month
      const firstDay = new Date(currentYear, currentMonth, 1);
      const lastDay = new Date(currentYear, currentMonth + 1, 0);
      
      // Add empty cells for days before the first day of the month
      for (let i = 0; i < firstDay.getDay(); i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'calendar-day empty';
        calendar.appendChild(emptyCell);
      }
      
      // Get formatted events
      const formattedEvents = formatEvents();
      
      // Add cells for each day of the month
      for (let day = 1; day <= lastDay.getDate(); day++) {
        const cell = document.createElement('div');
        cell.className = 'calendar-day';
        
        // Add day number
        const dayNumber = document.createElement('div');
        dayNumber.className = 'day-number';
        dayNumber.textContent = day;
        cell.appendChild(dayNumber);
        
        // Check if there are events on this day
        const dayEvents = formattedEvents.filter(event => {
          return event.parsedDate.getDate() === day && 
                 event.parsedDate.getMonth() === currentMonth && 
                 event.parsedDate.getFullYear() === currentYear;
        });
        
        // Add events to the cell
        if (dayEvents.length > 0) {
          cell.classList.add('has-events');
          
          // Sort events by time if available
          dayEvents.sort((a, b) => {
            if (a.parsedDate && b.parsedDate) {
              return a.parsedDate.getTime() - b.parsedDate.getTime();
            }
            return 0;
          });
          
          // Limit number of displayed events on small screens
          const isMobile = window.innerWidth <= 768;
          const eventsToShow = isMobile ? Math.min(2, dayEvents.length) : dayEvents.length;
          
          for (let i = 0; i < eventsToShow; i++) {
            const event = dayEvents[i];
            const eventEl = document.createElement('div');
            eventEl.className = 'calendar-event';
            eventEl.textContent = event.eventTitle;
            
            // Function to create event click handler
            function createEventClickHandler(event) {
              return function() {
                // Populate modal with event details
                const modal = document.getElementById('eventModal');
                const modalTitle = modal.querySelector('.event-modal-title');
                const modalMeta = modal.querySelector('.event-modal-meta');
                const modalDescription = modal.querySelector('.event-modal-description');
                
                modalTitle.textContent = event.eventTitle;
                
                // Format date for display
                const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                const formattedDate = event.parsedDate.toLocaleDateString('en-US', dateOptions);
                
                modalMeta.innerHTML = `
                  <p><strong>Date:</strong> ${formattedDate}</p>
                  ${event.eventLocation ? `<p><strong>Location:</strong> ${event.eventLocation}</p>` : ''}
                  ${event.eventTime ? `<p><strong>Time:</strong> ${event.eventTime}</p>` : ''}
                  ${event.eventTicketPrice ? `<p><strong>Price:</strong> ${event.eventTicketPrice}</p>` : ''}
                `;
                
                modalDescription.innerHTML = event.eventDescription || '<p>No description available</p>';
                
                // Add external website button if available
                if (event.eventWebsite) {
                  // Create a container div for the button with proper spacing
                  const buttonContainer = document.createElement('div');
                  buttonContainer.style.marginTop = "30px";
                  buttonContainer.style.textAlign = "center";
                  
                  // Create the button
                  const websiteButton = document.createElement('a');
                  websiteButton.href = event.eventWebsite;
                  websiteButton.target = "_blank";
                  websiteButton.rel = "noopener noreferrer";
                  websiteButton.className = "button button-primary";
                  websiteButton.style.display = "inline-block";
                  websiteButton.style.padding = "12px 25px";
                  websiteButton.style.fontSize = "16px";
                  websiteButton.style.textTransform = "uppercase";
                  websiteButton.style.fontWeight = "bold";
                  websiteButton.textContent = "Visit Event Website";
                  
                  // Add the button to the container and the container to the modal
                  buttonContainer.appendChild(websiteButton);
                  modalDescription.appendChild(buttonContainer);
                }
                
                // Show modal
                modal.style.display = 'block';
                
                // Close modal when clicking on the close button
                const closeBtn = modal.querySelector('.close-modal');
                closeBtn.onclick = function() {
                  modal.style.display = 'none';
                };
                
                // Close modal when clicking outside of it
                window.onclick = function(event) {
                  if (event.target === modal) {
                    modal.style.display = 'none';
                  }
                };
              };
            }
            
            // Add click functionality to show event details
            eventEl.addEventListener('click', createEventClickHandler(event));
            
            cell.appendChild(eventEl);
          }
          
          // Show "+X more" if there are more events
          if (dayEvents.length > eventsToShow) {
            const moreEl = document.createElement('div');
            moreEl.className = 'calendar-event more-events';
            moreEl.textContent = `+${dayEvents.length - eventsToShow} more`;
            moreEl.addEventListener('click', function() {
              // Create a temporary list of all events for this day
              const allEventsModal = document.getElementById('eventModal');
              const modalTitle = allEventsModal.querySelector('.event-modal-title');
              const modalMeta = allEventsModal.querySelector('.event-modal-meta');
              const modalDescription = allEventsModal.querySelector('.event-modal-description');
              
              modalTitle.textContent = `Events on ${monthNames[currentMonth]} ${day}, ${currentYear}`;
              modalMeta.innerHTML = '';
              
              // List all events
              let eventsList = '<ul class="events-list">';
              dayEvents.forEach(event => {
                eventsList += `
                  <li class="event-list-item">
                    <h4>${event.eventTitle}</h4>
                    ${event.eventTime ? `<p><strong>Time:</strong> ${event.eventTime}</p>` : ''}
                    ${event.eventLocation ? `<p><strong>Location:</strong> ${event.eventLocation}</p>` : ''}
                    ${event.eventTicketPrice ? `<p><strong>Price:</strong> ${event.eventTicketPrice}</p>` : ''}
                    ${event.eventDescription ? `<p>${event.eventDescription}</p>` : ''}
                    ${event.eventWebsite ? `<div style="margin-top: 25px; text-align: center;"><a href="${event.eventWebsite}" target="_blank" rel="noopener noreferrer" class="button button-primary" style="display: inline-block; padding: 10px 20px; font-size: 14px; text-transform: uppercase; font-weight: bold;">Visit Event Website</a></div>` : ''}
                  </li>
                `;
              });
              eventsList += '</ul>';
              
              modalDescription.innerHTML = eventsList;
              
              // Show modal
              allEventsModal.style.display = 'block';
            });
            
            cell.appendChild(moreEl);
          }
        }
        
        calendar.appendChild(cell);
      }
      
      // Add empty cells for days after the last day of the month
      const totalCells = firstDay.getDay() + lastDay.getDate();
      const remainingCells = 7 - (totalCells % 7);
      if (remainingCells < 7) {
        for (let i = 0; i < remainingCells; i++) {
          const emptyCell = document.createElement('div');
          emptyCell.className = 'calendar-day empty';
          calendar.appendChild(emptyCell);
        }
      }
    }
    
    // Navigation between months
    prevMonthBtn.addEventListener('click', function() {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderCalendar();
    });
    
    nextMonthBtn.addEventListener('click', function() {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderCalendar();
    });
    
    // Initial render
    renderCalendar();
  });
</script>
