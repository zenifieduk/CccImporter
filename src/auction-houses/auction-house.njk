---
layout: layouts/page.njk
pagination:
  data: auctionHouses
  size: 1
  alias: auctionHouse
permalink: "auction-houses/{{ auctionHouse.slug }}/"
eleventyComputed:
  title: "{{ auctionHouse.name }} - Classic Car Auctions"
  description: "Information about {{ auctionHouse.name }}, including upcoming auctions, company overview, and contact details."
  featuredImage: "{{ auctionHouse.logoUrl }}"
---

{% set breadcrumbs = [
  { url: '/auction-houses/', label: 'Auction Houses' },
  { url: '/auction-houses/' + auctionHouse.slug + '/', label: auctionHouse.name }
] %}

<div class="detail-header">
  <div class="container">
    <div class="breadcrumbs-container">
      <ul class="breadcrumbs">
        <li><a href="/">Home</a></li>
        {% for crumb in breadcrumbs %}
          <li><a href="{{ crumb.url }}">{{ crumb.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
    
    <h1 class="detail-title">{{ auctionHouse.name }}</h1>
    
    <div class="detail-meta">
      {% if auctionHouse.location %}
        <div class="detail-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {{ auctionHouse.location }}
        </div>
      {% endif %}
      
      {% if auctionHouse.website %}
        <div class="detail-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <a href="{{ auctionHouse.website }}" target="_blank" rel="noopener">{{ auctionHouse.website }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="detail-content">
  <div class="detail-main">
    <div class="auction-house-logo" style="margin: 0rem 0 2rem; text-align: center; border: 1px solid grey; border-radius: 15px; padding: 2rem 0 1rem;">
      {% if auctionHouse.logoUrl %}
        <img src="{{ auctionHouse.logoUrl }}" alt="{{ auctionHouse.name }} Logo" style="max-width: 300px; max-height: 520px;" onerror="this.src='/assets/images/auctions/auction-house-placeholder.svg'">
      {% else %}
        <img src="/assets/images/auctions/auction-house-placeholder.svg" alt="{{ auctionHouse.name }} Logo" style="max-width: 300px; max-height: 520px;">
      {% endif %}
      <h2>{{ auctionHouse.name }}</h2>
    </div>
    
    <div class="auction-house-about">
      <h2>About {{ auctionHouse.name }}</h2>
      <div class="rich-text">
        {{ auctionHouse.description | safe }}
      </div>
    </div>
    
    <div class="auction-house-upcoming" x-data="auctionHouseData()" x-init="init()">
      <h2 class="mt-5">Upcoming Auctions</h2>
      
      <div class="auction-grid auction-grid-2-col" x-show="upcomingAuctions.length > 0">
        <template x-for="auction in upcomingAuctions" :key="auction.auctionSlug">
          <div class="event-card">
            <template x-if="auction.auctionFeatured">
              <div class="event-featured">Featured</div>
            </template>
            
            <div class="event-image" style="height: auto; background-color: #f8f9fa; padding: 2rem 1rem; text-align: center; position: relative;">
              <h3 style="margin: 0; color: #333;">{{ auctionHouse.name }}</h3>
              
              <div class="event-date">
                <span class="event-month" x-text="formatMonth(auction.auctionStartDateTime)"></span>
                <span class="event-day" x-text="formatDay(auction.auctionStartDateTime)"></span>
              </div>
            </div>
            
            <div class="event-content">
              <h3 class="event-title" x-text="auction.auctionTitle"></h3>
              
              <div class="event-location" x-show="auction.auctionCity || auction.auctionState">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span x-text="(auction.auctionCity || '') + (auction.auctionCity && auction.auctionState ? ', ' : '') + (auction.auctionState || '')"></span>
              </div>
              
              <div class="event-time">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span x-text="formatTime(auction.auctionStartDateTime)"></span>
              </div>
              
              <div class="event-price" x-show="auction.auctionHighlightsHtml" x-html="auction.auctionHighlightsHtml"></div>
              <div class="event-price" x-show="!auction.auctionHighlightsHtml && auction.auctionHighlights" x-text="auction.auctionHighlights"></div>
            </div>
            
            <div class="event-actions">
              <a :href="'/auctions/' + auction.auctionSlug + '/'" class="button button-primary">VIEW DETAILS</a>
            </div>
          </div>
        </template>
      </div>
      
      <div class="no-auctions" x-show="upcomingAuctions.length === 0">
        <p>No upcoming auctions scheduled at this time. Please check back later or visit the auction house website for more information.</p>
