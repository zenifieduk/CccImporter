  .auction-house-upcoming .event-card {
    background-color: white !important;
    color: #333 !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1) !important;
  }
  
  .auction-house-upcoming .event-content {
    background-color: white !important;
    color: #333 !important;
  }
  
  .auction-house-upcoming .event-title {
    color: #333 !important;
  }
  
  .auction-house-upcoming .event-location,
  .auction-house-upcoming .event-time,
  .auction-house-upcoming .event-price {
    color: #666 !important;
  }
  
  .event-card {
    background-color: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  
  .event-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
  }
  
  .event-image {
    position: relative;
    height: 200px;
  }
  
  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .event-date {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: var(--primary-color);
    color: white;
    padding: 5px 10px;
    border-radius: 4px;
    text-align: center;
    min-width: 50px;
  }
  
  .event-month {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  
  .event-day {
    display: block;
    font-size: 1.2rem;
    font-weight: bold;
  }
  
  .event-featured {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: var(--primary-color);
    color: white;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: bold;
    z-index: 1;
  }
  
  .event-content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background-color: white;
  }
  
  .event-title {
    font-size: 1.25rem;
    margin: 0 0 1rem;
    color: #333;
  }
  
  .event-location, .event-time, .event-price {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    color: #666;
  }
  
  .event-price {
    margin-top: 0.5rem;
    font-weight: 500;
  }
  
  .event-actions {
    padding: 0 1.5rem 1.5rem;
    background-color: white;
  }
  
  .no-auctions {
    background-color: #f9f9f9;
    padding: 2rem;
    text-align: center;
    border-radius: 8px;
    margin-bottom: 2.5rem;
  }
</style>

<script>
  function auctionHouseData() {
    return {
      upcomingAuctions: [],
      pastAuctions: [],
      init() {
        // Filter auctions for this auction house
        const allAuctions = {{ auctions | dump | safe }};
        console.log("Debug - Auction house name:", '{{ auctionHouse.name }}');
        console.log("Debug - Auction house name lowercase:", '{{ auctionHouse.name | lower }}');
        console.log("Debug - All auctions:", allAuctions);
        
        const houseAuctions = allAuctions.filter(auction => {
          // Special case for H&H Classics due to encoding issues
          if ('{{ auctionHouse.slug }}' === 'h-and-h-classics' && auction.auctionHouse === 'H&H Classics') {
            return true;
          }
          
          console.log("Debug - Comparing:", auction.auctionHouse, auction.auctionHouse && auction.auctionHouse.toLowerCase(), '{{ auctionHouse.name | lower }}');
          return auction.auctionHouse && auction.auctionHouse.toLowerCase() === '{{ auctionHouse.name | lower }}'.replace('&amp;', '&');
        });
        
        console.log("Debug - Filtered auctions:", houseAuctions);
        
        // Split into upcoming and past auctions
        const now = new Date();
        this.upcomingAuctions = houseAuctions
          .filter(auction => {
            const auctionDate = this.parseAuctionDate(auction.auctionStartDateTime);
            return auctionDate >= now;
          })
          .sort((a, b) => this.parseAuctionDate(a.auctionStartDateTime) - this.parseAuctionDate(b.auctionStartDateTime));
          
        this.pastAuctions = houseAuctions
          .filter(auction => {
            const auctionDate = this.parseAuctionDate(auction.auctionStartDateTime);
            return auctionDate < now;
          })
          .sort((a, b) => this.parseAuctionDate(b.auctionStartDateTime) - this.parseAuctionDate(a.auctionStartDateTime));
      },
      parseAuctionDate(dateStr) {
        if (!dateStr) return new Date(0);
        const day = dateStr.substring(0, 2);
        const month = dateStr.substring(2, 4);
        const year = dateStr.substring(4, 8);
        const time = dateStr.substring(9);
        return new Date(year + '-' + month + '-' + day + 'T' + time);
      },
      formatMonth(dateStr) {
        const date = this.parseAuctionDate(dateStr);
        return date.toLocaleString('default', { month: 'short' });
      },
      formatDay(dateStr) {
        const date = this.parseAuctionDate(dateStr);
        return date.getDate();
      },
      formatTime(dateStr) {
        const date = this.parseAuctionDate(dateStr);
        return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }
    };
  }
</script>

