<!-- Calendar Script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle between views
    const cardsViewBtn = document.getElementById('cardsViewBtnAuction');
    const calendarViewBtn = document.getElementById('calendarViewBtnAuction');
    const auctionsCardsView = document.getElementById('auctionsCardsView');
    const auctionsCalendarView = document.getElementById('auctionsCalendarView');
    const auctionModal = document.getElementById('auctionModal'); // Renamed
    const closeModal = document.querySelector('.close-modal-auction'); // Renamed
    
    if (cardsViewBtn && calendarViewBtn && auctionsCardsView && auctionsCalendarView) {
      cardsViewBtn.addEventListener('click', function() {
        auctionsCardsView.style.display = 'block';
        auctionsCalendarView.style.display = 'none';
        cardsViewBtn.classList.add('active-view');
        cardsViewBtn.classList.remove('button-secondary');
        cardsViewBtn.classList.add('button-primary');
        calendarViewBtn.classList.remove('active-view');
        calendarViewBtn.classList.remove('button-primary');
        calendarViewBtn.classList.add('button-secondary');
      });
      
      calendarViewBtn.addEventListener('click', function() {
        auctionsCardsView.style.display = 'none';
        auctionsCalendarView.style.display = 'block';
        calendarViewBtn.classList.add('active-view');
        calendarViewBtn.classList.remove('button-secondary');
        calendarViewBtn.classList.add('button-primary');
        cardsViewBtn.classList.remove('active-view');
        cardsViewBtn.classList.remove('button-primary');
        cardsViewBtn.classList.add('button-secondary');
      });
    }
    
    // Close modal when clicking X or outside modal
    if (closeModal) {
      closeModal.addEventListener('click', function() {
        auctionModal.style.display = 'none';
      });
    }
    
    window.addEventListener('click', function(auction) { // Changed event to auction to avoid conflict
      if (auction.target === auctionModal) {
        auctionModal.style.display = 'none';
      }
    });
    
    // Calendar functionality
    const calendar = document.getElementById('calendarAuction'); // Renamed
    const calendarTitle = document.getElementById('calendarTitleAuction'); // Renamed
    const prevMonthBtn = document.getElementById('prevMonthAuction'); // Renamed
    const nextMonthBtn = document.getElementById('nextMonthAuction'); // Renamed
    
    if (!calendar || !calendarTitle || !prevMonthBtn || !nextMonthBtn) {
        console.error("Calendar elements not found!");
        return;
    }
    
    let currentDate = new Date();
    let currentMonth = currentDate.getMonth();
    let currentYear = currentDate.getFullYear();
    
    // Format auctions for the calendar
    function formatAuctions() { // Renamed from formatEvents
      return auctionsData.map(auction => { // Changed eventsData to auctionsData, event to auction
        let auctionDateVal; // Renamed from eventDate
        try {
          // Use existing parseAuctionDate function
          auctionDateVal = parseAuctionDate(auction.auctionStartDateTime);
        } catch (error) {
          console.error('Error parsing auction date:', auction.auctionStartDateTime, error);
          auctionDateVal = new Date(); // Default to today if parsing fails
        }
        
        return {
          ...auction,
          parsedDate: auctionDateVal
        };
      });
    }
    
    function renderCalendar() {
      // Clear previous calendar
      calendar.innerHTML = '';
      
      // Update header
      const monthNames = ["January", "February", "March", "April", "May", "June", 
                         "July", "August", "September", "October", "November", "December"];
      calendarTitle.textContent = `${monthNames[currentMonth]} ${currentYear}`;
      
      // Add day headers
      const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      dayNames.forEach(day => {
        const dayHeader = document.createElement('div');
        dayHeader.className = 'calendar-day-header';
        dayHeader.textContent = day;
        calendar.appendChild(dayHeader);
      });
      
      // Get first day of month and last day of month
      const firstDay = new Date(currentYear, currentMonth, 1);
      const lastDay = new Date(currentYear, currentMonth + 1, 0);
      
      // Add empty cells for days before the first day of the month
      for (let i = 0; i < firstDay.getDay(); i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'calendar-day empty';
        calendar.appendChild(emptyCell);
      }
      
      // Get formatted auctions
      const formattedAuctions = formatAuctions(); // Renamed from formattedEvents
      
      // Add cells for each day of the month
      for (let day = 1; day <= lastDay.getDate(); day++) {
        const cell = document.createElement('div');
        cell.className = 'calendar-day';
        
        // Add day number
        const dayNumber = document.createElement('div');
        dayNumber.className = 'day-number';
        dayNumber.textContent = day;
        cell.appendChild(dayNumber);
        
        // Check if there are auctions on this day
        const dayAuctions = formattedAuctions.filter(auction => { // Renamed from dayEvents, event to auction
          return auction.parsedDate.getDate() === day && 
                 auction.parsedDate.getMonth() === currentMonth && 
                 auction.parsedDate.getFullYear() === currentYear;
        });
        
        // Add auctions to the cell
        if (dayAuctions.length > 0) { // Renamed from dayEvents
          cell.classList.add('has-auctions'); // Renamed from has-events
          
          // Sort auctions by time if available
          dayAuctions.sort((a, b) => { // Renamed from dayEvents
            if (a.parsedDate && b.parsedDate) {
              return a.parsedDate.getTime() - b.parsedDate.getTime();
            }
            return 0;
          });
          
          const isMobile = window.innerWidth <= 768;
          const auctionsToShow = isMobile ? Math.min(2, dayAuctions.length) : dayAuctions.length; // Renamed
          
          for (let i = 0; i < auctionsToShow; i++) {
            const auction = dayAuctions[i]; // Renamed from event
            const auctionEl = document.createElement('div'); // Renamed from eventEl
            auctionEl.className = 'calendar-auction'; // Renamed from calendar-event
            auctionEl.textContent = auction.auctionTitle; // Changed event.eventTitle to auction.auctionTitle
            
            function createAuctionClickHandler(currentAuction) { // Renamed, currentAuction to avoid conflict
              return function() {
                const modal = document.getElementById('auctionModal'); // Renamed
                const modalTitle = modal.querySelector('.auction-modal-title'); // Renamed
                const modalMeta = modal.querySelector('.auction-modal-meta'); // Renamed
                const modalDescription = modal.querySelector('.auction-modal-description'); // Renamed
                
                modalTitle.textContent = currentAuction.auctionTitle; // Changed to currentAuction
                
                const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                const formattedDate = currentAuction.parsedDate.toLocaleDateString('en-US', dateOptions);
                
                // Adjust for auction data fields (e.g. auctionLocation, auctionHouse.auctionHouseName if available)
                // Assuming auction items have: auctionTitle, auctionStartDateTime, auctionLocation (might be auction.auctionVenue.venueAddress), auctionDescription, auctionSlug.
                // The global 'auctionsData' should have these details.
                // We need to ensure `currentAuction` has all necessary fields. `formatAuctions` spreads `...auction` so it should.

                let auctionHouseInfo = '';
                if (currentAuction.auctionHouse && currentAuction.auctionHouse.auctionHouseName) {
                    auctionHouseInfo = `<p><strong>Auction House:</strong> ${currentAuction.auctionHouse.auctionHouseName}</p>`;
                }
                
                let locationInfo = '';
                if (currentAuction.auctionVenue && currentAuction.auctionVenue.venueCity && currentAuction.auctionVenue.venueState) {
                    locationInfo = `<p><strong>Location:</strong> ${currentAuction.auctionVenue.venueCity}, ${currentAuction.auctionVenue.venueState}</p>`;
                } else if (currentAuction.auctionLocation) { // Fallback
                    locationInfo = `<p><strong>Location:</strong> ${currentAuction.auctionLocation}</p>`;
                }


                modalMeta.innerHTML = `
                  <p><strong>Date:</strong> ${formattedDate}</p>
                  <p><strong>Time:</strong> ${currentAuction.parsedDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</p>
                  ${auctionHouseInfo}
                  ${locationInfo}
                `;
                
                // Use auctionDescription or a default
                modalDescription.innerHTML = currentAuction.auctionDescription || '<p>No description available</p>';
                
                // Add View Auction Details button
                const buttonContainer = document.createElement('div');
                buttonContainer.style.marginTop = "30px";
                buttonContainer.style.textAlign = "center";
                
                const detailsButton = document.createElement('a');
                detailsButton.href = `/auctions/${currentAuction.auctionSlug}/`; // Link to auction details page
                detailsButton.className = "button button-primary";
                detailsButton.style.display = "inline-block";
                detailsButton.style.padding = "12px 25px";
                detailsButton.style.fontSize = "16px";
                detailsButton.style.textTransform = "uppercase";
                detailsButton.style.fontWeight = "bold";
                detailsButton.textContent = "View Auction Details";
                
                // Clear previous button if any, then add new one
                const existingButtonContainer = modalDescription.querySelector('div[style*="margin-top: 30px"]');
                if (existingButtonContainer) {
                    existingButtonContainer.remove();
                }
                buttonContainer.appendChild(detailsButton);
                modalDescription.appendChild(buttonContainer);
                                
                modal.style.display = 'block';
                
                const closeBtn = modal.querySelector('.close-modal-auction'); // Renamed
                closeBtn.onclick = function() {
                  modal.style.display = 'none';
                };
                
                window.onclick = function(auctionModalEvent) { // Renamed auctionModalEvent to avoid conflict
                  if (auctionModalEvent.target === modal) {
                    modal.style.display = 'none';
                  }
                };
              };
            }
            
            auctionEl.addEventListener('click', createAuctionClickHandler(auction)); // Renamed
            
            cell.appendChild(auctionEl); // Renamed
          }
          
          if (dayAuctions.length > auctionsToShow) { // Renamed
            const moreEl = document.createElement('div');
            moreEl.className = 'calendar-auction more-auctions'; // Renamed
            moreEl.textContent = `+${dayAuctions.length - auctionsToShow} more`; // Renamed
            moreEl.addEventListener('click', function() {
              const allAuctionsModal = document.getElementById('auctionModal'); // Renamed
              const modalTitle = allAuctionsModal.querySelector('.auction-modal-title'); // Renamed
              const modalMeta = allAuctionsModal.querySelector('.auction-modal-meta'); // Renamed
              const modalDescription = allAuctionsModal.querySelector('.auction-modal-description'); // Renamed
              
              modalTitle.textContent = `Auctions on ${monthNames[currentMonth]} ${day}, ${currentYear}`; // Renamed
              modalMeta.innerHTML = '';
              
              let auctionsListHTML = '<ul class="auctions-list">'; // Renamed
              dayAuctions.forEach(auction => { // Renamed
                // Adjust for auction data fields
                let auctionHouseInfoList = '';
                if (auction.auctionHouse && auction.auctionHouse.auctionHouseName) {
                    auctionHouseInfoList = `<p><strong>Auction House:</strong> ${auction.auctionHouse.auctionHouseName}</p>`;
                }
                let locationInfoList = '';
                 if (auction.auctionVenue && auction.auctionVenue.venueCity && auction.auctionVenue.venueState) {
                    locationInfoList = `<p><strong>Location:</strong> ${auction.auctionVenue.venueCity}, ${auction.auctionVenue.venueState}</p>`;
                } else if (auction.auctionLocation) { 
                    locationInfoList = `<p><strong>Location:</strong> ${auction.auctionLocation}</p>`;
                }

                auctionsListHTML += `
                  <li class="auction-list-item">
                    <h4>${auction.auctionTitle}</h4>
                    <p><strong>Time:</strong> ${auction.parsedDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</p>
                    ${auctionHouseInfoList}
                    ${locationInfoList}
                    ${auction.auctionDescription ? `<p>${auction.auctionDescription.substring(0,150)}...</p>` : ''}
                    <div style="margin-top: 15px; text-align: center;">
                      <a href="/auctions/${auction.auctionSlug}/" class="button button-secondary" style="display: inline-block; padding: 8px 15px; font-size: 13px;">View Details</a>
                    </div>
                  </li>
                `;
              });
              auctionsListHTML += '</ul>';
              
              modalDescription.innerHTML = auctionsListHTML;
              
              allAuctionsModal.style.display = 'block';
            });
            
            cell.appendChild(moreEl);
          }
        }
        
        calendar.appendChild(cell);
      }
      
      const totalCells = firstDay.getDay() + lastDay.getDate();
      const remainingCells = 7 - (totalCells % 7);
      if (remainingCells < 7) {
        for (let i = 0; i < remainingCells; i++) {
          const emptyCell = document.createElement('div');
          emptyCell.className = 'calendar-day empty';
          calendar.appendChild(emptyCell);
        }
      }
    }
    
    prevMonthBtn.addEventListener('click', function() {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderCalendar();
    });
    
    nextMonthBtn.addEventListener('click', function() {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderCalendar();
    });
    
    renderCalendar();
    // Ensure calendar is visible by default if it's the active view
    if (calendarViewBtn && calendarViewBtn.classList.contains('active-view')) {
        auctionsCalendarView.style.display = 'block';
        auctionsCardsView.style.display = 'none';
    } else if (cardsViewBtn) { // Default to cards if calendar isn't explicitly active (should not happen with current setup)
        auctionsCardsView.style.display = 'block';
        auctionsCalendarView.style.display = 'none';
    }


  });
</script>