        Discover standout <strong>classic car clubs in London</strong>, from historic marque groups to city-based gatherings and restoration crews. Tap into the capital's vibrant motoring scene and find the perfect club near you.
      </p>
    </div>

    <div class="club-grid featured-club-grid">
      {% set featuredClubs = clubs | filter("featured") | rejectattr("showcase", "truthy") %}
      {% for club in featuredClubs %}
        {% if club.city and club.city | lower == "london" %}
          {% include "components/club-card-fixed.njk" %}
        {% endif %}
      {% endfor %}
    </div>


    <div style="text-align: center; margin-top: 1rem;">
       <a href="/club-directory/london/" class="button button-primary">View London Clubs</a>
    </div>
  </div>
</section>

<section class="cta-section" style="background-color: #f9f9f9; width: 100vw; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); margin-top: 40px; margin-bottom: 0; padding: 4rem 0 4rem; text-align: center;">
  <div class="container">
    <h2 style="font-size: 2.5rem; margin-bottom: 1.5rem;">Can't find your club?</h2>
    <p style="font-size: 1.125rem; max-width: 800px; margin: 0 auto 2rem;">If you run or know of a classic car club that's not listed in our directory, we'd love to include it.</p>
    <a href="/pricing/" class="button button-primary">SUBMIT YOUR CLUB</a>
  </div>
</section>

<script>
  document.addEventListener('alpine:init', () => {
    // Define the eventDisplay Alpine component for auction date formatting
    Alpine.data('eventDisplay', () => ({
      formatMonth(dateStr) {
        // Convert a date string in "DDMMYYYY:HH:MM:SS" format to a valid Date object.
        const day = dateStr.substring(0, 2);
        const month = dateStr.substring(2, 4);
        const year = dateStr.substring(4, 8);
        const time = dateStr.substring(9); // time starts after the colon at index 8
        const date = new Date(year + '-' + month + '-' + day + 'T' + time);
        return date.toLocaleString('default', { month: 'short' });
      },
      formatDay(dateStr) {
        const day = dateStr.substring(0, 2);
        const month = dateStr.substring(2, 4);
        const year = dateStr.substring(4, 8);
        const time = dateStr.substring(9);
        const date = new Date(year + '-' + month + '-' + day + 'T' + time);
        return date.getDate();
      },
      formatTime(dateStr) {
        const day = dateStr.substring(0, 2);
        const month = dateStr.substring(2, 4);
        const year = dateStr.substring(4, 8);
        const time = dateStr.substring(9);
        const date = new Date(year + '-' + month + '-' + day + 'T' + time);
        return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }
    }));
  });
</script>

