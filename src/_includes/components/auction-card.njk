<div class="event-card" x-data="{
  // Date formatting functions
  formatMonth(dateStr) {
    if (!dateStr) return '';
    const day = dateStr.substring(0, 2);
    const month = dateStr.substring(2, 4);
    const year = dateStr.substring(4, 8);
    const time = dateStr.substring(9);
    const date = new Date(`${year}-${month}-${day}T${time}`);
    return date.toLocaleString('default', { month: 'short' });
  },
  formatDay(dateStr) {
    if (!dateStr) return '';
    const day = dateStr.substring(0, 2);
    const month = dateStr.substring(2, 4);
    const year = dateStr.substring(4, 8);
    const time = dateStr.substring(9);
    const date = new Date(`${year}-${month}-${day}T${time}`);
    return date.getDate();
  },
  formatTime(dateStr) {
    if (!dateStr) return '';
    const day = dateStr.substring(0, 2);
    const month = dateStr.substring(2, 4);
    const year = dateStr.substring(4, 8);
    const time = dateStr.substring(9);
    const date = new Date(`${year}-${month}-${day}T${time}`);
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  },
  // Auction house logo mapping function
  getAuctionHouseLogo(auctionHouseName) {
    if (!auctionHouseName) {
      return '/assets/images/auction-houses/auction-house-hero.avif';
    }
    
    // Create a mapping of auction house names to their logo file names
    const auctionHouseLogos = {
      'Anglia Car Auctions': 'anglia-car-auctions-logo.avif',
      'Brightwells': 'brightwells-auctions-logo.avif',
      'H&H Classics': 'h-and-h-classics-logo.avif',
      'Manor Park Classics': 'manor-park-classics-logo.avif',
      'Mathewsons': 'mathewsons-auction-house-logo.avif',
      'Car & Classic': 'car-and-classic-logo.avif',
      'Morris Leslie': 'morris-leslie-logo.avif',
      'Humbert & Ellis': 'humbert-ellis-logo.avif',
      'Historics': 'historics-logo.avif',
      'Hampson Marketplace': 'hampson-marketplace-logo.avif',
      'Ewbank\'s': 'ewbanks-logo.avif',
      'Ewbanks': 'ewbanks-logo.avif',
      'DVCA': 'dvca-logo.avif',
      'Classic Car Auctions': 'classic-car-auctions-logo.avif',
      'Charterhouse': 'charterhouse-auctions-logo.avif',
      'Dore & Rees': 'dore-and-rees-logo.avif',
      'Iconic Auctioneers': 'auction-house-hero.avif' // No specific logo available, use default
    };
    
    // Get the logo filename from the mapping
    const logoFilename = auctionHouseLogos[auctionHouseName];
    
    if (logoFilename) {
      return `/assets/images/auction-houses/${logoFilename}`;
    }
    
    // Fallback to default auction house image
    return '/assets/images/auction-houses/auction-house-hero.avif';
  }
}">
  <div class="event-featured" x-show="auction.auctionFeatured">Featured</div>
  
  <div class="event-image">
    <img :src="getAuctionHouseLogo(auction.auctionHouse)" :alt="auction.auctionHouse + ' Logo'">
    
    <div class="event-date">
      <span class="event-month" x-text="formatMonth(auction.auctionStartDateTime)"></span>
      <span class="event-day" x-text="formatDay(auction.auctionStartDateTime)"></span>
    </div>
  </div>
  
  <div class="event-content">
    <h3 class="event-title" x-text="auction.auctionTitle"></h3>
    
    {% if auction.auctionCity or auction.auctionState %}
      <div class="event-location">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span x-text="auction.auctionCity ? auction.auctionCity : ''"></span>
        <span x-text="auction.auctionCity && auction.auctionState ? ', ' : ''"></span>
        <span x-text="auction.auctionState ? auction.auctionState : ''"></span>
      </div>
    {% endif %}
    
    <div class="event-time">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      <span x-text="formatTime(auction.auctionStartDateTime)"></span>
    </div>
    
    <div class="event-location" x-show="auction.auctionHouse">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span><a :href="auction.auctionHouse === 'H&H Classics' ? '/auction-houses/h-and-h-classics/' : '/auction-houses/' + auction.auctionHouse.toLowerCase().replace(/ /g, '-') + '/'" x-text="auction.auctionHouse"></a></span>
    </div>
    
    <div class="event-price" x-show="auction.auctionHighlightsHtml" x-html="auction.auctionHighlightsHtml"></div>
    <div class="event-price" x-show="!auction.auctionHighlightsHtml && auction.auctionHighlights" x-text="auction.auctionHighlights"></div>
  </div>
  
  <div class="event-actions">
    <a :href="'/auctions/' + auction.auctionSlug + '/'" class="button button-primary">VIEW DETAILS</a>
  </div>
</div>