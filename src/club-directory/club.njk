---
layout: layouts/page.njk
pagination:
  data: clubs 
  size: 1
  alias: club
  addAllPagesToCollections: true
permalink: "club-directory/{{ club.slug | slugify }}/"
eleventyComputed:
  title: "{{ club.title }}"
  description: "Discover information about {{ club.title }}, including contact details, events, and more."

---

{% set breadcrumbs = [
  { url: '/club-directory/', label: 'Club Directory' },
  { url: '/club-directory/' + club.slug | slugify + '/', label: club.title }
] %}


<div class="detail-header">
  <div class="container">
    {% include "components/breadcrumb.njk" %}
    <h1 class="detail-title">{{ club.title }}</h1>

    <div class="detail-meta">
      {% if club.category %}
        <div class="detail-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <a href="/club-directory/?category={{ club.category | urlencode }}#results-section">{{ club.category }}</a>
        </div>
      {% endif %}

      {% if club.city %}
        <div class="detail-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <a href="/club-directory/?location={{ club.city | urlencode }}#results-section">{{ club.city }}</a>
        </div>
      {% endif %}

      {% if club.state %}
        <div class="detail-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <a href="/club-directory/?location={{ club.state | urlencode }}#results-section">{{ club.state }}</a>
        </div>
      {% endif %}

      {% if club.marque %}
        <div class="detail-meta-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <polyline points="17 11 19 13 23 9"></polyline>
          </svg>
          <a href="/club-directory/?search={{ club.marque | urlencode }}#results-section">{{ club.marque }}</a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="detail-content">
  <div class="detail-main">
      {% if club.imageUrl %}
      <div class="club-gallery" style="margin: 0rem 0rem 2rem 0rem;">
        <img src="{{ club.imageUrl }}" alt="{{ club.title }}" style="max-width: 100%; border-radius: 8px;">
  </div>
      {% endif %}

    {% if club.description %}
    <div class="club-description">
      <h2>About This Club</h2>
      {{ club.description | safe }}
  </div>
      {% endif %}

  
{% set category = club.category or 'Classic Car Club' %}
{% set location = club.city or club.state or 'United Kingdom' %}

<div class="club-highlights">
  <h2>Club Highlights</h2>
  <ul>
    <li>Category: {{ category }}</li>
    <li>Location: {{ location }}</li>
    {% if club.marque %}<li>Focus: {{ club.marque }} vehicles</li>{% endif %}
    {% if club.website %}<li>Official Website Available</li>{% endif %}
  </ul>

  <p class="last-updated">Last updated: {{ currentDate }}</p>



</div> 

<div class="cta-banner" style="margin-top: 3rem; padding: 1.5rem; background-color: #e8f5e9; border-left: 4px solid #1b5e20;">
  <p>Want to learn more about <strong>{{ club.title }}</strong>? Reach out to the club directly or <a href="/pricing/">get in touch</a> with our team for help.</p>
</div>

</div>



  <div class="detail-sidebar">
    <div class="detail-sidebar-section">
      <h3 class="detail-sidebar-title">Contact Information</h3>
      <ul style="list-style: none; padding: 0;">
        {% if club.address %}
          <li style="margin-bottom: 1rem;">
            <strong>Address:</strong><br>
            {{ club.address }}
          </li>
        {% endif %}

        {% if club.phone %}
          <li style="margin-bottom: 1rem;">
            <strong>Phone:</strong><br>
            <a href="tel:{{ club.phone | replace(' ', '') }}">{{ club.phone }}</a>
          </li>
        {% endif %}

        {% if club.email %}
          {% set emailParts = club.email.split("@") %}
            <li style="margin-bottom: 1rem;">
            <strong>Email:</strong><br>
             <a href="#" class="reveal-email"
               data-user="{{ emailParts[0] }}"
              data-domain="{{ emailParts[1] }}">Click to reveal email</a>
        </li>
        {% endif %}


        {% if club.website %}
          <li style="margin-bottom: 1rem;">
            <strong>Website:</strong><br>
            <a href="{{ club.website }}" target="_blank" rel="noopener">{{ club.website }}</a>
          </li>
        {% endif %}

        {% if club.membership %}
          <li style="margin-bottom: 1rem;">
            <strong>Membership:</strong><br>
            {{ club.membership}}
          </li>
        {% endif %}

        {% if club.facebook %}
          <li style="margin-bottom: 1rem;">
            <strong>Facebook:</strong><br>
            <a href="{{ club.facebook }}" target="_blank" rel="noopener">{{ club.facebook }}</a>
          </li>
        {% endif %}
      </ul>
    </div>

    <div class="detail-sidebar-section">
      <a href="{{ club.website }}" target="_blank" rel="noopener" class="button button-primary" style="width: 100%; text-align: center;">Visit Club Website</a>
    </div>
    <div class="update-notice">
    <p>Is this information incorrect or outdated? Please <a href="/contact" class="notice-link">contact us</a> using our form and we'll update it as soon as possible.</p>
  </div>
  </div>
  
</div>

<div class="container" style="margin-top: 3rem;">
  <div class="section-header">
    <h2 class="section-title">Featured Clubs</h2>
  </div>

  {% include "components/related-clubs.njk" %}

  <div style="text-align: center; margin-top: 2rem;">
    <a href="/club-directory/" class="button button-primary">View All Clubs</a>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const emailLinks = document.querySelectorAll('.reveal-email');

    emailLinks.forEach(link => {
      link.addEventListener('click', function (e) {
        e.preventDefault();
        const user = link.dataset.user;
        const domain = link.dataset.domain;
        const email = `${user}@${domain}`;
        link.href = `mailto:${email}`;
        link.textContent = email;
      });
    });
  });
</script>


<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ club.title }}",
  "description": "{{ club.description }}",
  "url": "{{ site.url }}/club-directory/{{ club.slug | slugify }}"{% if club.address or club.phone or club.email or club.imageUrl or club.facebook or club.twitter or club.website %},{% endif %}
  {% if club.address %}
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ club.address }}",
    "addressLocality": "{{ club.city or '' }}",
    "addressRegion": "{{ club.state or '' }}",
    "postalCode": "{{ club.postalCode or '' }}",
    "addressCountry": "GB"
  }{% if club.phone or club.email or club.imageUrl or club.facebook or club.twitter or club.website %},{% endif %}
  {% endif %}
  {% if club.phone %}
  "telephone": "{{ club.phone }}"{% if club.email or club.imageUrl or club.facebook or club.twitter or club.website %},{% endif %}
  {% endif %}
  {% if club.email %}
  "email": "{{ club.email }}"{% if club.imageUrl or club.facebook or club.twitter or club.website %},{% endif %}
  {% endif %}
  {% if club.imageUrl %}
  "image": "{% if club.imageUrl.indexOf('http') == 0 %}{{ club.imageUrl }}{% else %}{{ site.url ~ club.imageUrl }}{% endif %}"{% if club.facebook or club.twitter or club.website %},{% endif %}
  {% endif %}
  {% if club.facebook or club.twitter or club.website %}
  "sameAs": [
    {% set sameAsArr = [] %}
    {% if club.website %}
      {% set sameAsArr = sameAsArr.concat([club.website]) %}
    {% endif %}
    {% if club.facebook %}
      {% set sameAsArr = sameAsArr.concat([club.facebook]) %}
    {% endif %}
    {% if club.twitter %}
      {% set sameAsArr = sameAsArr.concat([club.twitter]) %}
    {% endif %}
    {% for url in sameAsArr -%}
      "{{ url }}"{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
  {% endif %}
}
</script>