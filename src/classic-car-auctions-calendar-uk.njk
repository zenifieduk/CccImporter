<!-- Calendar Scripts -->
<script>
  // Make auction data available to the calendar script
  var auctionsData = {{ auctions | dump | safe }};
  console.log('Initial auctionsData:', auctionsData); // Debug log

  // Helper function to parse auctionStartDateTime (copied from auctions.njk)
  function parseAuctionDate(dateStr) {
    if (!dateStr) return null;
    const day = dateStr.substring(0, 2);
    const month = dateStr.substring(2, 4);
    const year = dateStr.substring(4, 8);
    const time = dateStr.substring(9);
    return new Date(year + '-' + month + '-' + day + 'T' + time);
  }

  document.addEventListener('DOMContentLoaded', function() {
    const auctionModal = document.getElementById('auctionModal');
    const closeModal = document.querySelector('.close-modal-auction');
    
    if (closeModal && auctionModal) {
      closeModal.addEventListener('click', function() {
        auctionModal.style.display = 'none';
      });
      window.addEventListener('click', function(event) { // Changed variable name to avoid conflict with auction item
        if (event.target === auctionModal) {
          auctionModal.style.display = 'none';
        }
      });
    }
    
    const calendar = document.getElementById('calendarAuction');
    const calendarTitle = document.getElementById('calendarTitleAuction');
    const prevMonthBtn = document.getElementById('prevMonthAuction');
    const nextMonthBtn = document.getElementById('nextMonthAuction');
    
    if (!calendar || !calendarTitle || !prevMonthBtn || !nextMonthBtn) {
        console.error("Calendar elements not found for standalone calendar page!");
        return;
    }
    
    let currentDate = new Date();
    let currentMonth = currentDate.getMonth();
    let currentYear = currentDate.getFullYear();
    
    function formatAuctions() {
      return auctionsData.map(auction => {
        let auctionDateVal;
        try {
          auctionDateVal = parseAuctionDate(auction.auctionStartDateTime);
        } catch (error) {
          console.error('Error parsing auction date:', auction.auctionStartDateTime, error);
          auctionDateVal = new Date(); 
        }
        return { ...auction, parsedDate: auctionDateVal };
      });
    }
    
    function renderCalendar() {
      console.log('renderCalendar called. auctionsData:', auctionsData); // Debug log
      console.log('Current month:', currentMonth, 'Current year:', currentYear); // Debug log
      calendar.innerHTML = '';
      const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
      calendarTitle.textContent = `${monthNames[currentMonth]} ${currentYear}`;
      
      const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
      dayNames.forEach(day => {
        const dayHeader = document.createElement('div');
        dayHeader.className = 'calendar-day-header';
        dayHeader.textContent = day;
        calendar.appendChild(dayHeader);
      });
      
      const firstDay = new Date(currentYear, currentMonth, 1);
      const lastDay = new Date(currentYear, currentMonth + 1, 0);
      
      for (let i = 0; i < firstDay.getDay(); i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'calendar-day empty';
        calendar.appendChild(emptyCell);
      }
      
      const formattedAuctions = formatAuctions();
      
      for (let day = 1; day <= lastDay.getDate(); day++) {
        const cell = document.createElement('div');
        cell.className = 'calendar-day';
        
        const dayNumber = document.createElement('div');
        dayNumber.className = 'day-number';
        dayNumber.textContent = day;
        cell.appendChild(dayNumber);
        
        const dayAuctions = formattedAuctions.filter(auction => 
          auction.parsedDate && // Ensure parsedDate is valid
          auction.parsedDate.getDate() === day && 
          auction.parsedDate.getMonth() === currentMonth && 
          auction.parsedDate.getFullYear() === currentYear
        );
        
        if (dayAuctions.length > 0) {
          cell.classList.add('has-auctions');
          dayAuctions.sort((a, b) => (a.parsedDate && b.parsedDate) ? a.parsedDate.getTime() - b.parsedDate.getTime() : 0);
          
          const isMobile = window.innerWidth <= 768;
          const auctionsToShow = isMobile ? Math.min(2, dayAuctions.length) : dayAuctions.length;
          
          for (let i = 0; i < auctionsToShow; i++) {
            const auctionItem = dayAuctions[i]; // Renamed to avoid conflict
            const auctionEl = document.createElement('div');
            auctionEl.className = 'calendar-auction';
            auctionEl.textContent = auctionItem.auctionTitle;
            
            function createAuctionClickHandler(currentAuctionItem) { // Renamed to avoid conflict
              return function() {
                const modal = document.getElementById('auctionModal');
                const modalTitle = modal.querySelector('.auction-modal-title');
                const modalMeta = modal.querySelector('.auction-modal-meta');
                const modalDescription = modal.querySelector('.auction-modal-description');
                
                modalTitle.textContent = currentAuctionItem.auctionTitle;
                const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                const formattedDate = currentAuctionItem.parsedDate.toLocaleDateString('en-US', dateOptions);
                
                let auctionHouseInfo = '';
                if (currentAuctionItem.auctionHouse) { // Simplified check
                    auctionHouseInfo = `<p><strong>Auction House:</strong> ${currentAuctionItem.auctionHouse}</p>`;
                }
                
                let locationInfo = '';
                 if (currentAuctionItem.auctionCity && currentAuctionItem.auctionState) {
                    locationInfo = `<p><strong>Location:</strong> ${currentAuctionItem.auctionCity}, ${currentAuctionItem.auctionState}</p>`;
                } else if (currentAuctionItem.auctionAddress) { 
                    locationInfo = `<p><strong>Location:</strong> ${currentAuctionItem.auctionAddress}</p>`;
                }

                modalMeta.innerHTML = `
                  <p><strong>Date:</strong> ${formattedDate}</p>
                  <p><strong>Time:</strong> ${currentAuctionItem.parsedDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</p>
                  ${auctionHouseInfo}
                  ${locationInfo}
                `;
                
                modalDescription.innerHTML = currentAuctionItem.auctionHighlightsHtml ? currentAuctionItem.auctionHighlightsHtml : (currentAuctionItem.auctionHighlights || '<p>No highlights available</p>');
                
                const buttonContainer = document.createElement('div');
                buttonContainer.style.marginTop = "30px";
                buttonContainer.style.textAlign = "center";
                const detailsButton = document.createElement('a');
                detailsButton.href = `/auctions/${currentAuctionItem.auctionSlug}/`;
                detailsButton.className = "button button-primary";
                detailsButton.style.display = "inline-block";
                detailsButton.style.padding = "12px 25px";
                detailsButton.style.fontSize = "16px";
                detailsButton.style.textTransform = "uppercase";
                detailsButton.style.fontWeight = "bold";
                detailsButton.textContent = "View Auction Details";
                
                const existingButtonContainer = modalDescription.querySelector('div[style*="margin-top: 30px"]');
                if (existingButtonContainer) existingButtonContainer.remove();
                buttonContainer.appendChild(detailsButton);
                modalDescription.appendChild(buttonContainer);
                                
                modal.style.display = 'block';
              };
            }
            
            auctionEl.addEventListener('click', createAuctionClickHandler(auctionItem));
            cell.appendChild(auctionEl);
          }
          
          if (dayAuctions.length > auctionsToShow) {
            const moreEl = document.createElement('div');
            moreEl.className = 'calendar-auction more-auctions';
            moreEl.textContent = `+${dayAuctions.length - auctionsToShow} more`;
            moreEl.addEventListener('click', function() {
              const allAuctionsModal = document.getElementById('auctionModal');
              const modalTitle = allAuctionsModal.querySelector('.auction-modal-title');
              const modalMeta = allAuctionsModal.querySelector('.auction-modal-meta');
              const modalDescription = allAuctionsModal.querySelector('.auction-modal-description');
              
              modalTitle.textContent = `Auctions on ${monthNames[currentMonth]} ${day}, ${currentYear}`;
              modalMeta.innerHTML = '';
              let auctionsListHTML = '<ul class="auctions-list">';
              dayAuctions.forEach(auctionListItem => { // Renamed to avoid conflict
                let auctionHouseInfoList = '';
                if (auctionListItem.auctionHouse) { // Simplified check
                    auctionHouseInfoList = `<p><strong>Auction House:</strong> ${auctionListItem.auctionHouse}</p>`;
                }
                let locationInfoList = '';
                if (auctionListItem.auctionCity && auctionListItem.auctionState) {
                    locationInfoList = `<p><strong>Location:</strong> ${auctionListItem.auctionCity}, ${auctionListItem.auctionState}</p>`;
                } else if (auctionListItem.auctionAddress) {
                    locationInfoList = `<p><strong>Location:</strong> ${auctionListItem.auctionAddress}</p>`;
                }

                auctionsListHTML += `
                  <li class="auction-list-item">
                    <h4>${auctionListItem.auctionTitle}</h4>
                    <p><strong>Time:</strong> ${auctionListItem.parsedDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</p>
                    ${auctionHouseInfoList}
                    ${locationInfoList}
                    ${(auctionListItem.auctionHighlightsHtml ? auctionListItem.auctionHighlightsHtml : (auctionListItem.auctionHighlights || '')).substring(0,150)}...
                    <div style="margin-top: 15px; text-align: center;">
                      <a href="/auctions/${auctionListItem.auctionSlug}/" class="button button-secondary" style="display: inline-block; padding: 8px 15px; font-size: 13px;">View Details</a>
                    </div>
                  </li>
                `;
              });
              auctionsListHTML += '</ul>';
              modalDescription.innerHTML = auctionsListHTML;
              allAuctionsModal.style.display = 'block';
            });
            cell.appendChild(moreEl);
          }
        }
        calendar.appendChild(cell);
      }
      
      const totalCells = firstDay.getDay() + lastDay.getDate();
      const remainingCells = 7 - (totalCells % 7);
      if (remainingCells < 7) {
        for (let i = 0; i < remainingCells; i++) {
          const emptyCell = document.createElement('div');
          emptyCell.className = 'calendar-day empty';
          calendar.appendChild(emptyCell);
        }
      }
    }
    
    // Initial render
    if (auctionsData && auctionsData.length > 0) {
        renderCalendar();
    } else {
        if(calendar) calendar.innerHTML = '<p style="text-align:center; grid-column: 1 / span 7; padding: 2rem;">No auctions data found to display in the calendar.</p>';
    }

    prevMonthBtn.addEventListener('click', function() {
      currentMonth--;
      if (currentMonth < 0) { currentMonth = 11; currentYear--; }
      renderCalendar();
    });
    
    nextMonthBtn.addEventListener('click', function() {
      currentMonth++;
      if (currentMonth > 11) { currentMonth = 0; currentYear++; }
      renderCalendar();
    });
  });
</script>

