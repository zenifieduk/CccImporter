---
layout: layouts/base.njk
title: Blog
description: Latest news, tips, and guides about classic car clubs and events across the UK
permalink: /blog/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html
pagination:
  data: collections.blog
  size: 12
  alias: posts
eleventyExcludeFromCollections: true
---

<link rel="stylesheet" href="/assets/css/blog.css">

<section class="hero-section secondary-hero-section" style="height: 30vh; min-height: 450px; background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/assets/images/blog-header.avif'); background-size: cover; background-position: center;">
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="breadcrumbs-container">
      <ul class="breadcrumbs">
        <li><a href="/" style="color: white;">Home</a></li>
        <li><a href="/blog/" style="color: white;">Blog</a></li>
      </ul>
    </div>

    <div class="hero-content">
      <h1 class="hero-title">Blog</h1>
      <p class="hero-subtitle">News, tips, and guides about classic car clubs and events across the UK</p>
    </div>
  </div>
</section>

{% if collections.featuredPosts.length > 0 and pagination.pageNumber === 0 %}
<section class="featured-posts">
  <div class="container">
    <h2>Featured Articles</h2>
    <div class="featured-grid">
      {% for post in collections.featuredPosts %}
        <div class="featured-card">
          <div class="featured-badge">Featured</div>
          {% if post.data.featuredImage %}
            <div class="featured-card-image">
              <img src="{{ post.data.featuredImage }}" alt="{{ post.data.title }}">
            </div>
          {% endif %}
          <div class="featured-card-content">
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <div class="featured-card-meta">
              <span class="blog-date">{{ post.date | blogDate }}</span>
              <span class="blog-reading-time">{{ post.templateContent | readingTime }} min read</span>
            </div>
            <p>{{ post.data.excerpt or post.templateContent | excerpt }}</p>
            <a href="{{ post.url }}" class="read-more">Read More</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="blog-list">
  <div class="container">
    <div class="blog-sidebar-layout">
      <div class="blog-main">
        <h2>Latest Articles</h2>
        <div class="blog-grid">
          {% for post in posts %}
            <div class="blog-card">
              {% if post.data.featuredImage %}
                <div class="blog-card-image">
                  <img src="{{ post.data.featuredImage }}" alt="{{ post.data.title }}">
                </div>
              {% endif %}
              <div class="blog-card-content">
                <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
                <div class="blog-card-meta">
                  <span class="blog-date">{{ post.date | blogDate }}</span>
                  <span class="blog-reading-time">{{ post.templateContent | readingTime }} min read</span>
                </div>
                <p>{{ post.data.excerpt or post.templateContent | excerpt }}</p>
                <a href="{{ post.url }}" class="read-more">Read More</a>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Pagination -->
        {% if pagination.pages.length > 1 %}
          <nav class="pagination">
            <ul>
              {% if pagination.href.previous %}
                <li><a href="{{ pagination.href.previous }}">&laquo; Previous</a></li>
              {% else %}
                <li class="disabled"><span>&laquo; Previous</span></li>
              {% endif %}

              {% for pageEntry in pagination.pages %}
                <li{% if page.url == pagination.hrefs[ loop.index0 ] %} class="active"{% endif %}>
                  <a href="{{ pagination.hrefs[ loop.index0 ] }}">{{ loop.index }}</a>
                </li>
              {% endfor %}

              {% if pagination.href.next %}
                <li><a href="{{ pagination.href.next }}">Next &raquo;</a></li>
              {% else %}
                <li class="disabled"><span>Next &raquo;</span></li>
              {% endif %}
            </ul>
          </nav>
        {% endif %}
      </div>

      <div class="blog-sidebar">
        <div class="sidebar-section">
          <h3>Categories</h3>
          <ul class="category-list">
            {% for tag in collections.tagList %}
              <li><a href="/blog/category/{{ tag | slug }}/">{{ tag }}</a></li>
            {% endfor %}
          </ul>
        </div>

        <div class="sidebar-section">
          <h3>Recent Posts</h3>
          <ul class="recent-posts">
            {% for post in collections.recentPosts %}
              <li>
                <a href="{{ post.url }}">{{ post.data.title }}</a>
                <span class="post-date">{{ post.date | blogDate }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section> 